{
	"name": "re-color",
	"description": "Hello World!",
	"author": "jrwnnnn, kcirdneH, Idonowhatnametouse",
	"license": "MIT",
	"main": "main.js",
	"version": "1.0.0",
	"scripts": {
		"dev": "concurrently --kill-others \"vite\" \"electron main.js\"",
		"build": "vite build && electron-builder",
		"lint": "eslint .",
		"typecheck": "vue-tsc --noEmit",
		"test": "npm run lint && npm run typecheck && npm run build"
	},
	"build": {
		"appId": "com.teamReColor.recolor",
		"productName": "Re:Color Pre-Flight",
		"files": [
			"dist/**/*",
			"main.js",
			"preload.js"
		],
		"directories": {
			"output": "release"
		},
		"win": {
			"target": [
				"nsis",
				"portable"
			]
		},
		"nsis": {
			"artifactName": "${productName} ${version}-Setup.${ext}"
		},
		"portable": {
			"artifactName": "${productName} ${version}-Portable.${ext}"
		}
	},
	"dependencies": {
		"color-namer": "^1.4.0",
		"konva": "^9.3.6",
		"pinia": "^2.1.7",
		"vue": "^3.5.32"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.2.4",
		"@types/color-namer": "^1.3.3",
		"@types/node": "^24.12.2",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vue/tsconfig": "^0.9.1",
		"concurrently": "^9.2.1",
		"electron": "^41.3.0",
		"electron-builder": "^26.8.1",
		"eslint": "^10.2.1",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.7.3",
		"tailwindcss": "^4.2.4",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.0",
		"vite": "^8.0.10",
		"vite-svg-loader": "^5.1.1",
		"vue-tsc": "^3.2.7"
	}
}